# Copie para .env e preencha. O .env nunca deve ir para o Git nem ser servido pelo site.
TYPESAFE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_RESERVA=gemini-2.5-flash-lite
GEMINI_TIMEOUT=25
JEV_MODEL=jev-latest

# Testes sem gastar chamadas: 1 = simulador local (Jev) / texto de modelo (Gemini)
JEV_MOCK=0
GEMINI_MOCK=0

# Abaixo desta confiança, "fora do tema" não bloqueia a pergunta
LIMIAR_CONFIANCA=0.5

# Limite de perguntas por visitante (protege as chaves quando o site está no ar)
LIMITE_POR_MINUTO=6
LIMITE_POR_DIA=60
